package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_qcom_sm7250_display_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    //   legacy_not_a_contribution
    default_applicable_licenses: ["hardware_qcom_sm7250_display_license"],
}

composer_srcs = ["*.cpp"]

cc_binary {

    name: "vendor.qti.hardware.display.composer-service",
    defaults: ["qtidisplay_defaults"],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    relative_install_path: "hw",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"SDM\"",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libhistogram",
        "libutils",
        "libcutils",
        "libsync",
        "libc++",
        "liblog",
        "libhidlbase",
        "libfmq",
        "libhardware_legacy",
        "libsdmcore",
        "libqservice",
        "libqdutils",
        "libqdMetaData",
        "libdisplaydebug",
        "libsdmutils",
        "libui",
        "libgrallocutils",
        "libgpu_tonemapper",
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "vendor.qti.hardware.display.composer@3.0",
        "android.hardware.graphics.composer@2.1",
        "android.hardware.graphics.composer@2.2",
        "android.hardware.graphics.composer@2.3",
        "android.hardware.graphics.composer@2.4",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@2.1",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.allocator@3.0",
        "libdisplayconfig.qti",
        "libdrm",
        "com.google.hardware.pixel.display-V1-ndk",
        "libbinder_ndk",
        "libbase",
    ],
    srcs: composer_srcs,

    required: [
        "vendor.qti.hardware.display.composer-service.rc",
        "vendor.qti.hardware.display.composer-service.xml",
        "pixel-display-default.xml",
    ],

}

prebuilt_etc {
    name: "vendor.qti.hardware.display.composer-service.rc",
    src: "vendor.qti.hardware.display.composer-service.rc",
    filename_from_src: true,
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc_xml {
    name: "vendor.qti.hardware.display.composer-service.xml",
    src: "vendor.qti.hardware.display.composer-service.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    vendor: true,
}

prebuilt_etc_xml {
    name: "vendor.qti.hardware.display.composer-service-32bit.xml",
    src: "vendor.qti.hardware.display.composer-service-32bit.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    vendor: true,
    overrides: ["vendor.qti.hardware.display.composer-service.xml"],
}

prebuilt_etc_xml {
    name: "vendor.qti.hardware.display.composer-service-low-ram.xml",
    src: "vendor.qti.hardware.display.composer-service-low-ram.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    vendor: true,
    overrides: ["vendor.qti.hardware.display.composer-service.xml"],
}

prebuilt_etc_xml {
    name: "pixel-display-default.xml",
    src: "pixel-display-default.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    vendor: true,
}
